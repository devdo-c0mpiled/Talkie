{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talkie",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SFU_LIVE", "class_name": "SfuLiveSession" },
      { "name": "TELEPHONE_LISTEN", "class_name": "TelephoneListen" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SfuLiveSession", "TelephoneListen"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talkie-db",
      "database_id": "b5fad7d1-7cf3-4c1c-a48f-2245ab13b6b2"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://talkie.devdo.workers.dev"
  }
}
